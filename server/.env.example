NODE_ENV=development
PORT=4000

DATABASE_PATH=./data/mansa.db
UPLOAD_DIR=./uploads

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Optional presentation accounts. Use dedicated synthetic accounts; never point the demo admin at a real operator account.
DEMO_MODE_ENABLED=false
DEMO_FREELANCER_USER_ID=
DEMO_BUYER_USER_ID=
DEMO_PARENT_USER_ID=
DEMO_ADMIN_USER_ID=

CORS_ORIGIN=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

ADMIN_NAME=مدير المنصة
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Optional WhatsApp Cloud API delivery (requires an approved template with two body variables).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Gmail SMTP for parent verification emails (use a Google App Password, not your account password).
SMTP_USER=
SMTP_APP_PASSWORD=
