NODE_ENV=production
DATABASE_PATH=/data/mansa.db
UPLOAD_DIR=/data/uploads
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://${{RAILWAY_PUBLIC_DOMAIN}}
FRONTEND_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
OAUTH_FRONTEND_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
